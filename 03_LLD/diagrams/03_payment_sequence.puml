@startuml

autonumber

title SALESTORM - Payment Processing & Resilience

actor Customer

participant "Payment Service" as PaymentSvc
participant "Payment Gateway Adapter" as Adapter
participant "Circuit Breaker" as CB
participant "External PSP" as PSP
participant "Kafka Message Bus" as Kafka

Customer -> PaymentSvc: POST /api/v1/payments/charge

PaymentSvc -> PaymentSvc: Check Idempotency Key

alt Transaction Already Processed

    PaymentSvc --> Customer: Existing Payment Result

else New Transaction

    PaymentSvc -> CB: Execute Payment

    alt Circuit CLOSED

        CB -> Adapter: executePayment()
        Adapter -> PSP: Charge Request

        alt Payment Success

            PSP --> Adapter: Approved\nTXN_REF_99
            Adapter --> CB: SUCCESS
            CB --> PaymentSvc: SUCCESS

            PaymentSvc -> Kafka: PaymentSucceededEvent
            PaymentSvc --> Customer: HTTP 200 OK

        else Payment Declined

            PSP --> Adapter: Payment Rejected
            Adapter --> CB: FAILED
            CB --> PaymentSvc: FAILED

            PaymentSvc -> Kafka: PaymentFailedEvent
            PaymentSvc --> Customer: HTTP 402

        else PSP Timeout

            PSP --> Adapter: Network Timeout
            Adapter --> CB: TIMED_OUT
            CB --> PaymentSvc: TIMED_OUT

            PaymentSvc -> Kafka: PaymentPendingReconciliationEvent
            PaymentSvc --> Customer: HTTP 202 Accepted

        end

    else Circuit OPEN

        CB --> PaymentSvc: Fail Fast
        PaymentSvc --> Customer: PSP Temporarily Unavailable

    end
end

@enduml
