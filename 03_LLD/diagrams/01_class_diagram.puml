@startuml

skinparam classAttributeIconSize 0
skinparam style strictuml

title SALESTORM - Low Level Design Class Diagram

package "Domain Entities" {

    class Inventory {
        - inventoryId: String
        - productId: String
        - availableQuantity: int
        - reservedQuantity: int
        - soldQuantity: int
        - version: long

        + reserve(quantity: int): boolean
        + confirmReservation(quantity: int): void
        + releaseReservation(quantity: int): void
    }

    class InventoryReservation {
        - reservationId: String
        - customerId: String
        - productId: String
        - quantity: int
        - status: ReservationStatus
        - expiresAt: LocalDateTime
        - idempotencyKey: String

        + isExpired(): boolean
        + markConfirmed(): void
        + markReleased(): void
    }

    enum ReservationStatus {
        RESERVED
        PAYMENT_PENDING
        CONFIRMED
        RELEASED
        EXPIRED
    }

    class Order {
        - orderId: String
        - customerId: String
        - reservationId: String
        - totalAmount: BigDecimal
        - status: OrderStatus
        - createdAt: LocalDateTime

        + updateStatus(newStatus: OrderStatus): void
    }

    enum OrderStatus {
        CREATED
        PAYMENT_PENDING
        CONFIRMED
        PROCESSING
        SHIPPED
        OUT_FOR_DELIVERY
        DELIVERED
        CANCELLED
    }

    class PaymentTransaction {
        - paymentId: String
        - orderId: String
        - idempotencyKey: String
        - amount: BigDecimal
        - status: PaymentStatus
        - providerReference: String

        + markSuccess(providerRef: String): void
        + markFailed(reason: String): void
    }

    enum PaymentStatus {
        INITIATED
        SUCCESS
        FAILED
        TIMED_OUT
    }
}

package "Repositories & Contracts" {

    interface InventoryRepository {
        + findByProductId(productId: String): Inventory
        + save(inventory: Inventory): void
        + reserveWithOptimisticLock(productId: String, qty: int, version: long): boolean
    }

    interface PaymentGateway {
        + processPayment(request: PaymentRequest): PaymentResponse
    }

    interface OrderRepository {
        + save(order: Order): void
        + findById(orderId: String): Order
        + updateStatus(orderId: String, status: OrderStatus): void
    }
}

Inventory "1" -- "0..*" InventoryReservation : tracks

Order "1" -- "1" PaymentTransaction : associated with

InventoryRepository ..> Inventory
OrderRepository ..> Order
PaymentGateway ..> PaymentTransaction

@enduml
